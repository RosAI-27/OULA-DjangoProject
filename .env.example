# Copy to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Conversational analytics agent (required only when using the chat)
GOOGLE_API_KEY=replace-with-your-google-ai-studio-key
LLM_MODEL=google_genai:YOUR_SUPPORTED_MODEL_ID
LLM_MODELES_SECOURS=google_genai:YOUR_FALLBACK_MODEL_ID
API_BASE_URL=http://127.0.0.1:8000/api
